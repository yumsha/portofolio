        <span class="text-sm">Astro</span>
      </div>
    </div>
  </div>
</section>


    <!-- Projek -->
    <div id="projects" class="w-full max-w-6xl mt-64 px-4 py-16 mx-auto">
      <h2 class="text-3xl font-bold text-white mb-10 text-center">Proyek Saya</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Project Card -->
        <div class="bg-zinc-900 rounded-xl shadow-lg overflow-hidden group transition hover:-translate-y-1 hover:shadow-xl duration-300">
          <img src="/assets/project1.png" alt="Project 1" class="w-full h-52 object-cover">
          <div class="p-5">
            <h3 class="text-white text-lg font-semibold mb-1">Automated Chat System</h3>
            <p class="text-gray-400 text-sm mb-4">
              Sistem chatbot  otomatis Discord dengan integrasi dari discord.js untuk memberikan pesan otomatis kepada user setiap text-channel baru dibuat.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="bg-blue-600/10 text-blue-400 text-xs font-medium px-3 py-1 rounded-full">Express</span>
              <span class="bg-blue-600/10 text-blue-400 text-xs font-medium px-3 py-1 rounded-full">JavaScript</span>
              <span class="bg-blue-600/10 text-blue-400 text-xs font-medium px-3 py-1 rounded-full">NodeJS</span>
              <span class="bg-blue-600/10 text-blue-400 text-xs font-medium px-3 py-1 rounded-full">Discord.js</span>
            </div>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="bg-zinc-900 rounded-xl shadow-lg overflow-hidden group transition hover:-translate-y-1 hover:shadow-xl duration-300">
          <img src="/assets/project2.png" alt="Project 2" class="w-full h-52 object-cover">
          <div class="p-5">
            <h3 class="text-white text-lg font-semibold mb-1">Shopily – ECommerce Platform</h3>
            <p class="text-gray-400 text-sm mb-4">
              Web e-commerce modular dengan fitur keranjang belanja, checkout, dan integrasi pembayaran. lalu menggunakan integrasi API untuk data produk 
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="bg-blue-600/10 text-blue-400 text-xs font-medium px-3 py-1 rounded-full">HTML5</span>
              <span class="bg-blue-600/10 text-blue-400 text-xs font-medium px-3 py-1 rounded-full">JavaScript</span>
              <span class="bg-blue-600/10 text-blue-400 text-xs font-medium px-3 py-1 rounded-full">TailwindCSS</span>
            </div>
          </div>
        </div>

        <!-- Project 3 -->
        <div class="bg-zinc-900 rounded-xl shadow-lg overflow-hidden group transition hover:-translate-y-1 hover:shadow-xl duration-300">
          <img src="/assets/project3.png" alt="Project 3" class="w-full h-52 object-cover">
          <div class="p-5">
            <h3 class="text-white text-lg font-semibold mb-1">Portofolio Websites</h3>
            <p class="text-gray-400 text-sm mb-4">
              Website portofolio pribadi yang menampilkan proyek, keterampilan, dan informasi kontak saya. Dibuat dengan Astro dan Tailwind CSS untuk performa optimal dan desain responsif.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="bg-blue-600/10 text-blue-400 text-xs font-medium px-3 py-1 rounded-full">Astro</span>
              <span class="bg-blue-600/10 text-blue-400 text-xs font-medium px-3 py-1 rounded-full">React</span>
              <span class="bg-blue-600/10 text-blue-400 text-xs font-medium px-3 py-1 rounded-full">TailwindCSS</span>
            </div>
          </div>
        </div>
      </div>
    </div>


  <footer class=" mt-10  text-white w-full">
    <!-- divider -->
    <div class="w-full h-px bg-zinc-800 my-8"></div>
    <div class="w-full max-w-6xl mx-auto text-center py-4 px-4">
      <p class="text-gray-400 text-sm">© 2025 Muhamad Riza Pahlevi. All rights reserved.</p>
      <p class="text-gray-500 text-xs mt-1">Made with ☕ by yumsha using Astro and Tailwind CSS</p>
    </div>
  </footer>
  </main>
  <script>
  const roles = [
    "Front-end Developer",
    "Back-end Developer",
    "3D Artist"
  ];

  const rotator = document.getElementById("role-rotator");
  let i = 0;

  function rotateText() {
    if (!rotator) return;

    rotator.classList.remove("animate-fadeSlideUp");

    setTimeout(() => {
      rotator.textContent = roles[i];
      rotator.classList.add("animate-fadeSlideUp");
      rotator.classList.remove("animate-fadeOut");

      i = (i + 1) % roles.length;
    }, 500);
  }

  rotateText();
  setInterval(rotateText, 3000);


</script>

</Layout>
