---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navbar -->
  <div class="fixed top-6 left-1/2 -translate-x-1/2 z-50 w-fit px-6 py-2 bg-zinc-900/60 backdrop-blur-md text-white rounded-full shadow-lg flex items-center gap-6 border border-zinc-800">
    <div class="flex gap-6 text-sm font-medium">
      <a href="#home" class="hover:text-indigo-400 transition">Home</a>
      <a href="#about" class="hover:text-indigo-400 transition">About</a>
      <a href="#projects" class="hover:text-indigo-400 transition">Projects</a>
    </div>
    <span class="h-6 w-px bg-zinc-700 mx-2"></span>
    <div class="flex gap-4 text-lg">
      <a href="https://github.com/yumsha" target="_blank" aria-label="GitHub" class="hover:text-indigo-400 transition">
        <i class="fa-brands fa-github"></i>
      </a>
      <a href="/resume.pdf" target="_blank" aria-label="Resume" class="hover:text-indigo-400 transition">
        <i class="fa-regular fa-file-lines"></i>
      </a>
    </div>
  </div>



  
  <main class="min-h-screen flex flex-col items-center justify-center bg-gradient-to-b from-[#000000] to-[#52057B]">
    <div class="min-h-[80vh] flex items-center justify-between px-8 mt-32  md:px-20 py-12 text-white relative">
      <!-- Kiri -->
      <div class="max-w-xl z-10">
        <h1 class="text-3xl sm:text-4xl font-semibold mb-2">
          Halo semuanya! <span class="inline-block animate-wave">👋</span>, saya
        </h1>
        <h2 class="text-4xl sm:text-5xl font-extrabold text-[#892CDC] mb-6">Muhamad Riza Pahlevi</h2>
        <p class="text-lg leading-relaxed text-zinc-300 mb-6">
          Seorang Web Developer yang antusias menciptakan pengalaman web yang modern, dan user-friendly.
        </p>

        <!-- Icon Sosial -->
        <div class="flex gap-4">
          <a href="https://github.com/yumsha" target="_blank" class="bg-zinc-900/60 backdrop-blur-md p-3 rounded-full text-xl">
            <i class="fa-brands fa-github"></i>
          </a>
          <a href="https://linkedin.com/muhamadrizapahlevi" target="_blank" class="bg-zinc-900/60 backdrop-blur-md p-3 rounded-full text-xl">
            <i class="fa-brands fa-linkedin-in"></i>
          </a>
          <a href="mailto:muhamadrizapahlevi12@gmail.com" class="bg-zinc-900/60 backdrop-blur p-3 rounded-full text-xl">
            <i class="fa-regular fa-envelope"></i>
          </a>
        </div>
      </div>

      <!-- Kanan -->
      <!-- <div class="relative hidden md:block"> -->
        <!-- Background bentuk -->
        <!-- <div class="absolute -top-6 -left-10 w-48 h-64 bg-teal-500 rounded-[60%] z-0"></div> -->
        <!-- Foto -->
        <!-- <img src="/assets/riza.png" alt="Foto Riza" class="relative z-10 w-64 object-contain" /> -->
      <!-- </div> -->
    </div>

    <!-- About ME -->
  <div id="about" class="px-6 mt-32 md:px-20 py-20 text-white">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-start gap-10">
    
    <!-- Kiri: Teks -->
    <div class="flex-1">
      <h2 class="text-3xl font-bold mb-2 text-white">Tentang Saya</h2>
      <h3 class="text-xl font-semibold text-indigo-400 mb-4 h-6 overflow-hidden relative">
        <span id="role-rotator" class="block text-indigo-400 transition-all duration-500"></span>
      </h3>
      <p class="text-zinc-300 leading-relaxed">
        Saya <span class="text-white font-medium">Muhamad Riza Pahlevi</span>, seorang junior developer dengan fokus pada pengembangan web dan eksplorasi kecerdasan buatan. 
        Terbiasa membangun antarmuka modern dan responsif menggunakan <span class="text-white font-medium">TypeScript</span> serta framework seperti <span class="text-white font-medium">TailwindCSS</span> dan <span class="text-white font-medium">Astro</span>. 
        Selain itu, saya mendalami <span class="text-white font-medium">Python</span> untuk pemrograman umum dan machine learning, dengan pengalaman menggunakan <span class="text-white font-medium">PyTorch</span> dan <span class="text-white font-medium">Hugging Face</span> untuk mengembangkan serta mengimplementasikan model AI. 
        Saya juga memiliki dasar dalam software 3D seperti <span class="text-white font-medium">Blender</span> untuk pembuatan asset maupun mod game.
      </p>

    </div>

    <!-- Kanan: Skill Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 flex-1">
      <div class="bg-zinc-900 rounded-lg p-4 flex flex-col items-center hover:bg-zinc-800 transition">
