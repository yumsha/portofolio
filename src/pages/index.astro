      </div>
      <div class="bg-zinc-900 rounded-lg p-4 flex flex-col items-center hover:bg-zinc-800 transition">
        <i class="fa-brands fa-python text-[#892CDC] text-2xl mb-2"></i>
        <span class="text-sm">Python</span>
      </div>
      <div class="bg-zinc-900 rounded-lg p-4 flex flex-col items-center hover:bg-zinc-800 transition">
        <i class="fa-brands fa-js text-[#892CDC] text-2xl mb-2"></i>
        <span class="text-sm">JavaScript</span>
      </div>
      <div class="bg-zinc-900 rounded-lg p-4 flex flex-col items-center hover:bg-zinc-800 transition">
        <i class="fa-solid fa-wind text-[#892CDC] text-2xl mb-2"></i>
        <span class="text-sm">Tailwind CSS</span>
      </div>
      <div class="bg-zinc-900 rounded-lg p-4 flex flex-col items-center hover:bg-zinc-800 transition">
        <i class="fa-brands fa-node-js text-[#892CDC] text-2xl mb-2"></i>
        <span class="text-sm">Node.js</span>
      </div>
      <div class="bg-zinc-900 rounded-lg p-4 flex flex-col items-center hover:bg-zinc-800 transition">
        <i class="fab fa-php text-[#892CDC] text-2xl mb-2"></i>
        <span class="text-sm">php</span>
      </div>
      <div class="bg-zinc-900 rounded-lg p-4 flex flex-col items-center hover:bg-zinc-800 transition">
        <i class="fa-solid fa-cube text-[#892CDC] text-2xl mb-2"></i>
        <span class="text-sm">Blender</span>
      </div>
      <div class="bg-zinc-900 rounded-lg p-4 flex flex-col items-center hover:bg-zinc-800 transition">
        <i class="fa-solid fa-cubes text-[#892CDC] text-2xl mb-2"></i>
        <span class="text-sm">Autodesk</span>
      </div>
      <div class="bg-zinc-900 rounded-lg p-4 flex flex-col items-center hover:bg-zinc-800 transition">
