---
const skillGroups = [
  {
    name: 'Frontend',
    color: 'primary',
    bg: 'bg-blue-light',
    text: 'text-primary',
    skills: [
      { name: 'TypeScript', icon: 'fa-brands fa-js' },
      { name: 'React.js', icon: 'fa-brands fa-react' },
      { name: 'Next.js', icon: 'fa-solid fa-n' },
      { name: 'Astro', icon: 'fa-solid fa-star' },
      { name: 'HTML5', icon: 'fa-brands fa-html5' },
      { name: 'Tailwind CSS', icon: 'fa-solid fa-wind' },
    ],
  },
  {
    name: 'Backend',
    color: 'secondary',
    bg: 'bg-orange-light',
    text: 'text-secondary',
    skills: [
      { name: 'Node.js', icon: 'fa-brands fa-node-js' },
      { name: 'Express.js', icon: 'fa-solid fa-server' },
      { name: 'Python', icon: 'fa-brands fa-python' },
      { name: 'Kotlin', icon: 'fa-solid fa-code' },
      { name: 'REST APIs', icon: 'fa-solid fa-plug' },
    ],
  },
  {
    name: 'Database',
    color: 'success',
    bg: 'bg-green-light',
    text: 'text-success',
    skills: [
      { name: 'PostgreSQL', icon: 'fa-solid fa-database' },
      { name: 'MySQL', icon: 'fa-solid fa-database' },
      { name: 'Prisma ORM', icon: 'fa-solid fa-cubes' },
    ],
  },
  {
    name: 'Tools',
    color: 'muted',
    bg: 'bg-zinc-200',
    text: 'text-ink',
    skills: [
      { name: 'Docker', icon: 'fa-brands fa-docker' },
      { name: 'Linux', icon: 'fa-brands fa-linux' },
      { name: 'Git', icon: 'fa-brands fa-git-alt' },
      { name: 'PyTorch', icon: 'fa-solid fa-fire' },
      { name: 'Hugging Face', icon: 'fa-solid fa-face-smile' },
    ],
  },
];
---

<section id="skills" class="px-6 md:px-20 py-20">
  <div class="max-w-7xl mx-auto">
    <div class="section-label bg-green-light text-success mb-8 rotate-1">
      <i class="fa-solid fa-wrench mr-1"></i> Skills
    </div>

    <h2 class="text-3xl md:text-4xl font-black mb-10">
      Tech I work <span class="text-primary">with</span>.
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {skillGroups.map((group) => (
        <div class="neo-card overflow-hidden">
          <div class={`${group.bg} border-b-2 border-ink px-5 py-3`}>
            <h3 class={`font-bold text-lg ${group.text}`}>{group.name}</h3>
          </div>
          <div class="p-5 space-y-2">
            {group.skills.map((skill) => (
              <div class="flex items-center gap-3 py-1.5">
                <i class={`${skill.icon} ${group.text} w-5 text-center`}></i>
                <span class="text-sm font-medium">{skill.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
