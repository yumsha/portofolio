    color: 'primary',
    bg: 'bg-blue-light',
    accent: 'bg-primary',
    icon: 'fa-solid fa-school',
    category: 'Web App',
    links: [
      { url: 'https://github.com/Exulify/Exulify', label: 'Frontend' },
      { url: 'https://github.com/Exulify/Exulify-API', label: 'API' },
    ],
  },
  {
    name: 'PiringNegeri',
    tagline: 'Indonesian Culinary Heritage Platform',
    description:
      'An ecosystem dedicated to Indonesian culinary heritage, connecting food enthusiasts with authentic flavors through modern technology. Includes a REST API backend, an Astro-powered web frontend, and a React Native mobile app.',
    stack: ['JavaScript', 'Express.js', 'Astro', 'React Native', 'PostgreSQL'],
    color: 'success',
    bg: 'bg-green-light',
    accent: 'bg-success',
    icon: 'fa-solid fa-bowl-food',
    category: 'Web App',
    links: [{ url: 'https://github.com/PiringNegeri', label: 'Organization' }],
  },
  {
    name: 'TakeOver',
    tagline: 'Mobile App — Refactory Hackathon',
    description:
      'Mobile application built during the TakeOver offline hackathon (Refactory x Amikom Yogyakarta). Core features developed in Kotlin with a structured Android architecture. Achieved 4th place out of 15 teams.',
    stack: ['Kotlin', 'Android'],
    color: 'secondary',
    bg: 'bg-orange-light',
    accent: 'bg-secondary',
    icon: 'fa-solid fa-mobile-screen-button',
    category: 'Mobile',
    links: [{ url: 'https://github.com/yumsha/takeover-fe', label: 'GitHub' }],
  },
  {
    name: 'Face Recognition App',
    tagline: 'Real-time Face Detection & Recognition',
    description:
      'A real-time face recognition app using a webcam feed. Detects and compares faces against a known dataset, labels recognized individuals by name, and draws bounding boxes on detected faces.',
    stack: ['Python', 'OpenCV', 'face_recognition'],
    color: 'primary',
    bg: 'bg-blue-light',
    accent: 'bg-primary',
    icon: 'fa-solid fa-camera',
    category: 'AI / ML',
    links: [{ url: 'https://github.com/yumsha/facedetection', label: 'GitHub' }],
  },
  {
    name: 'Fake News Detection',
    tagline: 'ML-based News Classifier',
    description:
      'A machine learning-based fake news classifier. Trains on labeled news datasets (true.csv / fake.csv) and detects whether a given news article is real or fabricated.',
    stack: ['Python', 'scikit-learn'],
    color: 'secondary',
    bg: 'bg-orange-light',
    accent: 'bg-secondary',
    icon: 'fa-solid fa-brain',
    category: 'AI / ML',
    links: [{ url: 'https://github.com/yumsha/fake-news-detection', label: 'GitHub' }],
  },
  {
    name: 'BengkelPancong Bot',
    tagline: 'Discord Ticket Bot',
    description:
      'A Discord bot for automating ticket management. Automatically sends rich embed messages when a ticket is created, supports image embeds (QR codes, payment screenshots), prevents duplicate messages from conflicting bots, and handles multi-category ticket flows via environment variables. Deployed on Render for 24/7 uptime.',
    stack: ['Node.js', 'discord.js v14', 'Express.js', 'dotenv', 'Render.com'],
