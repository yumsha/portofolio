---

<section id="projects" class="px-6 md:px-20 py-20">
  <div class="max-w-7xl mx-auto">
    <div class="section-label bg-orange-light text-secondary mb-8 rotate-1">
      <i class="fa-solid fa-folder-open mr-1"></i> Projects
    </div>

    <h2 class="text-3xl md:text-4xl font-black mb-6">
      Things I've <span class="text-primary">built</span>.
    </h2>

    <!-- Category Filter -->
    <div id="project-filters" class="flex flex-wrap gap-2 mb-10">
      {categories.map((cat) => (
        <button
          class="filter-btn text-sm font-semibold px-4 py-1.5 border-2 border-ink rounded-lg transition-all duration-200 shadow-neo-sm cursor-pointer
            {cat === 'All' ? 'bg-ink text-white' : 'bg-white text-ink hover:shadow-neo-sm-hover hover:-translate-x-0.5 hover:-translate-y-0.5'}"
          data-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, i) => (
        <div
          class="project-card neo-card overflow-hidden flex flex-col"
          data-category={project.category}
          data-index={i}
        >
          <!-- Colored top bar -->
          <div class={`${project.accent} h-2 border-b-2 border-ink`}></div>

          <div class="p-6 flex flex-col flex-1">
            <!-- Icon + Name + Category -->
            <div class="flex items-center gap-3 mb-3">
              <div
                class={`${project.bg} border-2 border-ink rounded-lg w-10 h-10 flex items-center justify-center flex-shrink-0`}
              >
                <i
                  class={`${project.icon} ${project.color === 'primary' ? 'text-primary' : project.color === 'secondary' ? 'text-secondary' : 'text-success'}`}
                ></i>
              </div>
              <div class="min-w-0">
                <h3 class="font-bold text-lg leading-tight truncate">{project.name}</h3>
                <p
                  class={`text-xs font-semibold truncate ${project.color === 'primary' ? 'text-primary' : project.color === 'secondary' ? 'text-secondary' : 'text-success'}`}
                >
                  {project.tagline}
                </p>
              </div>
            </div>

            <!-- Description -->
            <p class="text-muted text-sm leading-relaxed mb-4 flex-1">
              {project.description}
            </p>

            <!-- Stack badges -->
            <div class="flex flex-wrap gap-1.5 mb-4">
              {project.stack.map((tech) => (
                <span class="font-mono text-[11px] font-medium px-2 py-0.5 border-2 border-ink rounded bg-surface">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Footer: Category tag + Links -->
            <div class="flex items-center justify-between mt-auto pt-3 border-t-2 border-ink/10">
              <!-- Category Tag -->
              <span
                class={`${categoryStyles[project.category]?.bg} ${categoryStyles[project.category]?.text} font-mono text-[10px] font-bold px-2 py-0.5 border-2 border-ink rounded`}
              >
                {project.category}
              </span>

              <!-- Links / Private Badge -->
              <div class="flex items-center gap-1.5">
                {project.isPrivate ? (
                  <span class="flex items-center gap-1 font-mono text-[10px] font-bold text-muted px-2 py-0.5 border-2 border-muted/40 rounded bg-surface/50">
                    <i class="fa-solid fa-lock text-[9px]"></i>
                    Private
                  </span>
                ) : (
                  project.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 font-mono text-[10px] font-bold text-ink px-2 py-0.5 border-2 border-ink rounded bg-white shadow-neo-sm hover:shadow-neo-sm-hover hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200"
                    >
                      <i class="fa-brands fa-github text-xs"></i>
                      {link.label}
                    </a>
                  ))
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Show All Button -->
    <div id="show-all-container" class="flex justify-center mt-8 hidden">
      <button
        id="show-all-btn"
        class="neo-btn-outline text-sm gap-2"
      >
        <i class="fa-solid fa-chevron-down text-xs"></i>
        Show all {projects.length} projects
      </button>
    </div>
  </div>
</section>

<script>
  const INITIAL_VISIBLE = 3;

  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.project-card');
  const showAllContainer = document.getElementById('show-all-container');
  const showAllBtn = document.getElementById('show-all-btn');

  let activeCategory = 'All';
  let expanded = false;

  function render() {
    const isAllCategory = activeCategory === 'All';

    cards.forEach((card) => {
      const index = parseInt(card.dataset.index, 10);
      const matchCategory = isAllCategory || card.dataset.category === activeCategory;

      // In the "All" category, collapse beyond INITIAL_VISIBLE unless expanded
      const passCollapse = !isAllCategory || expanded || index < INITIAL_VISIBLE;

      card.style.display = matchCategory && passCollapse ? 'flex' : 'none';
    });

    // Count visible cards in the current filter to know the total
    const totalFiltered = Array.from(cards).filter(
      (c) => c.dataset.category === activeCategory || activeCategory === 'All'
    ).length;

    // Show "Show all" button only for "All" category when collapsed and there are hidden cards
    if (isAllCategory && !expanded && cards.length > INITIAL_VISIBLE) {
      showAllContainer.classList.remove('hidden');
      showAllBtn.innerHTML =
        '<i class="fa-solid fa-chevron-down text-xs"></i> Show all ' +
        cards.length +
        ' projects';
    } else {
      showAllContainer.classList.add('hidden');
    }
  }

  function filterProjects(category) {
    activeCategory = category;
    expanded = false;

    filterBtns.forEach((btn) => {
      const isActive = btn.dataset.category === category;
      btn.classList.toggle('bg-ink', isActive);
      btn.classList.toggle('text-white', isActive);
      btn.classList.toggle('bg-white', !isActive);
      btn.classList.toggle('text-ink', !isActive);
    });

    render();
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterProjects(btn.dataset.category);
    });
  });

  showAllBtn.addEventListener('click', () => {
    expanded = true;
    render();
  });

  // Initial render
  render();
</script>
